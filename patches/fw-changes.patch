+            if (!wr_set_op_mode(MAX32664C_OP_MODE_STOP_ALGO, MAX32664C_ALGO_MODE_NONE)) {
+                hpi_research_state(HPR_WRIST, HPR_ERROR);
+            }
+        } else {
+            running = true;
+            atomic_set(&spo2_measurement_in_progress, 1);
